        }
      },
      "definition": "select \"constructor_championships\".\"session_key\", \"constructor_championships\".\"team_name\", \"constructor_championships\".\"points_current\", \"constructor_championships\".\"points_start\", \"constructor_championships\".\"position_current\", \"constructor_championships\".\"position_start\" from \"constructor_championships\" inner join (select \"constructor_championships\".\"session_key\" from \"constructor_championships\" inner join \"sessions\" on \"constructor_championships\".\"session_key\" = \"sessions\".\"session_key\" where \n          \"sessions\".\"year\" = extract(year from now())::int\n          and \"sessions\".\"date_end\":: timestamptz < now()\n         order by \"sessions\".\"date_start\"::timestamptz desc limit 1) \"latest_session\" on \"constructor_championships\".\"session_key\" = \"latest_session\".\"session_key\"",
      "name": "constructor_standings_latest",
      "schema": "public",
      "isExisting": false,
      "materialized": false
